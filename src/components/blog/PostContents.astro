---
// "On this page" for a blog post. `rail` is the list in the side rail from 1024px up (the post page keeps the rail
// in view); `bar` is the sticky "Contents" disclosure that replaces it below 1024px. Both are plain anchor links,
// so they work without JavaScript. Both list the post's sections (its h2s) only. The script marks the section
// being read (aria-current="location") and names it in the bar; the post page draws reading progress. The bar steps down
// below the site header while headroom.ts shows it. Its list opens over the text rather than pushing it down, so
// opening or closing it never moves the page under a jump to a section.
import Icon from '../primitives/Icon.astro';
export interface ContentsHeading { depth: number; slug: string; text: string }
interface Props { headings: ContentsHeading[]; variant: 'rail' | 'bar' }
const { headings, variant } = Astro.props;
const sections = headings.filter(heading => heading.depth === 2);
---
{variant === 'rail'
 ? <nav class="contents-rail" aria-label="On this page" data-contents>
    <h2>On this page</h2>
    <ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
    <a class="to-top" href="#main">Back to top</a>
   </nav>
 : <details class="contents-bar" data-contents data-contents-bar>
    <summary><span class="bar-label">Contents</span><span class="bar-current" data-contents-current></span><Icon name="chevron-down" /></summary>
    <nav aria-label="On this page"><ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></nav>
   </details>}
<script>
 const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-contents] a[href^="#"]:not(.to-top)')];
 const ids=[...new Set(links.map(link=>decodeURIComponent(link.hash.slice(1))))];
 const headings=ids.map(id=>document.getElementById(id)).filter((el):el is HTMLElement=>!!el)
  .sort((a,b)=>a.compareDocumentPosition(b)&Node.DOCUMENT_POSITION_FOLLOWING?-1:1);
 const bar=document.querySelector<HTMLDetailsElement>('[data-contents-bar]');
 const current=bar?.querySelector<HTMLElement>('[data-contents-current]');
 let queued=false;
 const update=()=>{
  queued=false;
  // A heading counts as reached once it passes a line a little below the header.
  const line=Math.min(160,innerHeight*.3);
  let reached:HTMLElement|undefined;
  for(const heading of headings){if(heading.getBoundingClientRect().top<=line)reached=heading;else break;}
  const section=reached?.id;
  for(const link of links){
   if(link.hash.slice(1)===section)link.setAttribute('aria-current','location');
   else link.removeAttribute('aria-current');
  }
  if(current)current.textContent=reached?.textContent?.trim()??'';
 };
 if(headings.length){
  addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(update);}},{passive:true});
  addEventListener('resize',update);
  update();
 }
 // The bar closes once a section is chosen, on Escape, and when a press or focus lands outside it, since the open
 // list covers the text.
 bar?.addEventListener('click',event=>{if((event.target as Element).closest('a'))bar.open=false;});
 bar?.addEventListener('keydown',event=>{if(event.key==='Escape'&&bar.open){bar.open=false;bar.querySelector('summary')?.focus();}});
 bar?.addEventListener('focusout',event=>{const next=event.relatedTarget as Node|null;if(bar.open&&next&&!bar.contains(next))bar.open=false;});
 document.addEventListener('pointerdown',event=>{if(bar?.open&&!bar.contains(event.target as Node))bar.open=false;});
</script>
<style>
 h2{font:600 14px/20px var(--font-heading);color:var(--muted-foreground);margin:0 0 12px}
 ol{list-style:none;margin:0;padding:0}
 .contents-rail a{display:block;padding:8px 0 8px 16px;border-left:1px solid var(--web-outline);font:400 15px/22px var(--font-heading);color:var(--muted-foreground);text-decoration:none;text-wrap:pretty}
 .contents-rail a:hover{color:var(--foreground);border-left-color:var(--brand-hover-edge)}
 .contents-rail a[aria-current]{color:var(--foreground);border-left:2px solid var(--primary);padding-left:15px}
 .contents-rail .to-top{display:inline-flex;align-items:center;min-height:44px;margin-top:12px;padding:0;border:0;font:400 14px/20px var(--font-heading);color:var(--muted-foreground);text-decoration:none}
 .to-top:hover{color:var(--foreground);text-decoration:underline;text-underline-offset:5px}

 /* As wide as the text column on tablets; edge to edge on phones, where the column fills the container. It stacks
    over the sitewide field (page-field.ts, z-index 10), whose squares are placed for where the bar first sits, and
    under the site header (20). */
 .contents-bar{position:sticky;top:0;z-index:11;background:var(--background);border-block:1px solid var(--web-outline);transition:top 280ms var(--ease-reveal)}
 @media(max-width:767px){.contents-bar{margin-inline:calc(var(--page-gutter) * -1);padding-inline:var(--page-gutter)}}
 :global(html:has(.site-header[data-stuck]:not([data-hidden]))) .contents-bar{top:96px}
 summary{display:flex;align-items:center;gap:12px;min-height:52px;cursor:pointer;list-style:none;font:600 14px/20px var(--font-heading)}
 summary::-webkit-details-marker{display:none}
 summary:focus-visible{outline:2px solid var(--ring);outline-offset:-2px}
 .bar-label{color:var(--muted-foreground);flex:none}
 .bar-current{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--foreground)}
 summary :global(.web-icon){margin-left:auto;transition:transform 200ms var(--ease-reveal)}
 .contents-bar[open] summary :global(.web-icon){transform:rotate(180deg)}
 /* The open list hangs below the bar's bottom rule as a panel over the text. */
 .contents-bar nav{position:absolute;top:calc(100% + 1px);left:0;right:0;max-height:min(60vh,420px);overflow-y:auto;padding:8px 16px 12px;background:var(--background);border:1px solid var(--web-outline);border-top:0}
 @media(max-width:767px){.contents-bar nav{padding-inline:var(--page-gutter);border-inline:0}}
 .contents-bar nav a{display:block;padding:10px 0 10px 16px;border-left:1px solid var(--web-outline);font:400 15px/22px var(--font-heading);color:var(--muted-foreground);text-decoration:none}
 .contents-bar nav a:hover{color:var(--foreground);border-left-color:var(--brand-hover-edge)}
 .contents-bar nav a[aria-current]{color:var(--foreground);border-left:2px solid var(--primary);padding-left:15px}
 @media(min-width:1024px){.contents-bar{display:none}}
 @media(prefers-reduced-motion:reduce){.contents-bar,summary :global(.web-icon){transition:none}}
 @media(forced-colors:active){.contents-rail a[aria-current],.contents-bar nav a[aria-current]{border-left-color:Highlight}}
 @media print{.contents-rail,.contents-bar{display:none}}
</style>
