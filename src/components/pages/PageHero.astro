---
interface Props {
  title: string;
  lead: string;
}
const { title, lead } = Astro.props;
const hasArt = Astro.slots.has('art');
---
<header class="page-hero">
  <div class:list={['site-container', { 'has-art': hasArt }]}>
    <div class="page-hero-text">
      <hgroup>
        <h1>{title}</h1>
        <p class="page-hero-lead">{lead}</p>
      </hgroup>
      <slot />
    </div>
    {hasArt && <div class="page-hero-art"><slot name="art" /></div>}
  </div>
</header>
<style>
  .page-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  .page-hero-text {
    display: grid;
    justify-items: start;
    align-content: start;
    row-gap: 1.25rem;
    min-inline-size: 0;
  }
  h1 {
    font-size: clamp(2rem, 1.5rem + 3vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -.03em;
    overflow-wrap: anywhere;
  }
  .page-hero-lead {
    margin-block-start: clamp(.75rem, 1.25vw, 1rem);
    max-inline-size: 58ch;
    font-size: clamp(1.0625rem, 1rem + .3vw, 1.25rem);
    line-height: 1.5;
    color: var(--muted-foreground);
  }
  .has-art {
    display: grid;
    gap: 2.5rem 3rem;
  }
  @media (min-width: 1024px) {
    .has-art {
      grid-template-columns: minmax(0, 780px) auto;
      justify-content: space-between;
      align-items: center;
    }
  }
  @media print {
    .page-hero { padding-block: 0 1.5rem; break-inside: avoid; }
  }
</style>
