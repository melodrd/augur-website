---
import Brand from '../primitives/Brand.astro';
import Icon from '../primitives/Icon.astro';
import Button from '../primitives/Button.astro';
import {navigation,navigationGroups,pages,type NavigationItem} from '../../data/navigation';
import {links} from '../../data/links';
import {newsletter} from '../../data/newsletter';
import {forms} from '../../data/forms';
// Two parts, with no rule and no box between or around them (melo, 15 Nov 2026).
// 1. The contact call, on the page's own Navy and laid out as a section heading: the title on the left, its
//    sentence and the action on the right.
// 2. The footer proper, a full-width band a step lighter than the page, like the homepage's "Keep going" band.
//    It holds the logo and the newsletter field on the left, the link directory on the right and a base line
//    under both. Each destination is listed once: the community places are the Community column only.
// The footer proper sits on the site's 500 / 80 / 668 heading grid, so the first link column and the legal
// links share one edge with every section above. One footer nav landmark; every footer heading is an h2, a
// peer of the contact title rather than nested under it.
// On the homepage the footer settles in as one group, with no stagger (reveal.js); every other page renders
// it unchanged.
const reveal=Astro.url.pathname==='/'?'':undefined;
// `band={false}` drops the contact call for a page that ends with its own contact block, so the two don't
// stack: the FAQ's "Still have a question?" (owner, 15 Nov 2026). The footer proper stays, newsletter included.
interface Props { band?: boolean }
const { band = true } = Astro.props;
// The newsletter field has its own switch (forms.newsletter). Off, the logo stands alone in its column.
const url=forms.newsletterUrl;
---
<footer class="site-footer" data-reveal={reveal}>
  {band && <div id="contact" class="contact-band">
    <div class="site-container section-heading">
      <h2 id="contact-title">Talk to the Augur team.</h2>
      <div class="contact-copy"><p class="lead">Ask about the protocol or share feedback. Building on it? Tell us what your project needs.</p><div class="contact-actions"><Button href={pages.contact}>Talk to us</Button></div></div>
    </div>
  </div>}
  <div class="footer-main">
    <div class="site-container footer-grid directory">
      <div class="identity">
        <a href="/" aria-label="Augur home"><Brand /></a>
        {forms.newsletter && <div class="newsletter"><h2 id="newsletter-title">Follow Augur's progress</h2><p>Research, development and product updates, by email.</p>
          <form class="newsletter-form" action={url ? url+newsletter.path : undefined} method={url ? 'post' : 'dialog'} aria-labelledby="newsletter-title" data-newsletter={url ? 'live' : 'offline'}>
            <div class="field"><label for="newsletter-email">Email address</label><div class="newsletter-control"><input type="email" id="newsletter-email" name="email" autocomplete="email" inputmode="email" enterkeyhint="send" autocapitalize="none" spellcheck="false" placeholder="you@example.com" required maxlength="254" aria-describedby="newsletter-email-error" /><button type="submit" class="button newsletter-submit">Subscribe</button></div></div>
            {url && <div class="newsletter-trap" aria-hidden="true"><label for="newsletter-nickname">Leave this empty</label><input type="text" id="newsletter-nickname" name={forms.honeypot} tabindex="-1" autocomplete="off" /></div>}
            <p class="field-error" id="newsletter-email-error" hidden></p>
            <p class="newsletter-status" role="status" aria-live="polite" data-newsletter-status></p>
            {!url && <noscript><p class="newsletter-note">Email sign-up isn’t connected yet, so nothing is sent or saved.</p></noscript>}
          </form></div>}
      </div>
      <nav class="footer-links" aria-label="Footer">{navigationGroups.map(group=><div><h2>{group.label}</h2><ul>{group.items.map(item=><li><a class="line-link" href={item.href}>{(item as NavigationItem).logo&&<Icon name={(item as NavigationItem).logo!} class="social-logo"/>}<span class="button-label">{item.label}</span>{('external' in item && item.external)&&<Icon name="arrow-up-right"/>}</a></li>)}</ul></div>)}</nav>
    </div>
    <div class="site-container footer-grid base">
      <p>Augur's work is funded and coordinated by the <a href={links.foundation.url}>Lituus Foundation<Icon name="arrow-up-right"/></a>.</p>
      <div class="base-links"><ul class="legal-links" aria-label="Legal">{navigation.legal.map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul><a class="to-top" href="#top">Back to top<Icon name="arrow-right"/></a></div>
    </div>
  </div>
</footer>
<script>
 // Without JavaScript the form posts to the augur-forms Worker, which redirects to a result page.
 // Here it validates first, posts in place and shows the Worker's message: only `ok` means stored.
 // A form-urlencoded body keeps the cross-origin POST a simple request, with no CORS preflight.
 // Offline (no PUBLIC_FORMS_URL in the build), method="dialog" keeps submits local and the
 // script says plainly that nothing was sent.
 import {isEmail,newsletter} from '../../data/newsletter';
 const form=document.querySelector<HTMLFormElement>('[data-newsletter]');
 if(form){
  form.noValidate=true;
  const input=form.querySelector<HTMLInputElement>('input[type=email]')!;
  const error=form.querySelector<HTMLElement>('#newsletter-email-error')!;
  const status=form.querySelector<HTMLElement>('[data-newsletter-status]')!;
  // A flag, not button.disabled: disabling the focused button would drop keyboard focus.
  let sending=false;
  const showError=(message:string)=>{error.textContent=message;error.hidden=!message;input.setAttribute('aria-invalid',String(Boolean(message)));};
  const validate=()=>{
   const value=input.value.trim();
   const message=!value?'Enter your email address.':input.validity.typeMismatch||!isEmail(value)?newsletter.messages.invalid:'';
   showError(message);
   return !message;
  };
  input.addEventListener('blur',()=>{if(input.value.trim()||input.getAttribute('aria-invalid')==='true')validate();});
  input.addEventListener('input',()=>{status.replaceChildren();if(input.getAttribute('aria-invalid')==='true')validate();});
  form.addEventListener('submit',async event=>{
   event.preventDefault();if(sending)return;status.replaceChildren();
   if(!validate()){input.focus();return;}
   if(form.dataset.newsletter==='offline'){
    const blog=document.createElement('a');blog.href='/blog/';blog.textContent='Follow the blog';
    status.append('Email sign-up isn’t connected yet, so nothing was sent or saved. ',blog,' for updates in the meantime.');
    return;
   }
   sending=true;form.setAttribute('aria-busy','true');
   try{
    const body=new URLSearchParams([...new FormData(form)].map(([key,value])=>[key,String(value)]));
    const response=await fetch(form.action,{method:'POST',body,headers:{accept:'application/json'}});
    const result=await response.json() as {ok:boolean;status:string;message:string;fieldErrors?:Record<string,string>};
    if(result.status==='invalid'){showError(result.fieldErrors?.email??result.message);input.focus();}
    else{status.textContent=result.message;if(result.ok)form.reset();}
   }catch{status.textContent=newsletter.messages.error;}
   finally{sending=false;form.removeAttribute('aria-busy');}
  });
 }
</script>
<style>
/* The contact call is a section heading (global.css) that ends its section, so it drops the heading's gap. */
.contact-band{padding-block:var(--section-space)}
.contact-band :global(.section-heading){margin-bottom:0}
.contact-copy{display:grid;justify-items:start;gap:32px}
/* The footer points to the contact page alone; the page gives the email address (owner, 30 Oct 2026). */

/* The footer proper: one full-width band, the page container inside it. */
.footer-main{padding-block:80px 40px;background:var(--web-quiet)}
.footer-grid{display:grid;grid-template-columns:minmax(0,500fr) minmax(0,668fr);gap:80px}
.directory{align-items:start}
/* The logo heads the first column, level with the link headings; the newsletter sits under it, no wider than
   its field reads well. */
.identity{display:grid;justify-items:start;gap:40px}
.newsletter{width:100%;max-width:440px}
.newsletter h2{font-size:20px;line-height:26px;letter-spacing:0;margin-bottom:8px}.newsletter>p{color:var(--muted-foreground);margin-bottom:20px}
/* The field and its button are one control: a Navy well, a step darker than the band, with the design system's
   hairline along its base and the button joined to its right end at the same height. The button is quiet until
   it is pointed at or focused, then Green, so the contact call above keeps the one filled Green button. The
   focus ring is drawn inside the field, where the joined button cannot cover it. */
.newsletter .field{gap:10px}
.newsletter-control{display:flex;align-items:stretch}
.newsletter .field input{flex:1;background:var(--web-well)}.newsletter .field input:hover{background:var(--background)}
.newsletter .field input:focus-visible{outline-offset:-2px}
.newsletter-submit{flex:none;min-height:0;padding:0 20px;border:0;border-bottom:1px solid var(--color-mist);background:var(--web-raised);color:var(--foreground);transition:background-color 180ms ease-out,color 180ms ease-out,border-color 180ms ease-out}
.newsletter-submit:hover,.newsletter-submit:focus-visible{background:var(--primary);color:var(--primary-foreground);border-bottom-color:var(--primary)}
.newsletter-submit:active{background:var(--primary-active);border-bottom-color:var(--primary-active)}
@media(prefers-reduced-motion:reduce){.newsletter-submit{transition:none}}
@media(forced-colors:active){.newsletter-submit{border:1px solid ButtonText}}
.newsletter .field-error{margin-top:12px}.newsletter-status{margin-top:12px;font-size:14px;line-height:20px;color:var(--muted-foreground)}.newsletter-status:empty{display:none}.newsletter-status a{color:var(--foreground)}
/* No consent line under the field (melo, 15 Nov 2026); the note is the no-JavaScript line of the offline field. */
.newsletter-note{margin-top:12px;font-size:14px;line-height:20px;color:var(--muted-foreground)}
/* Off-screen rather than display:none, so form-filling bots still see the trap field. */
.newsletter-trap{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
.footer-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px}
.footer-links h2{font:600 14px/20px var(--font-heading);letter-spacing:0;color:var(--muted-foreground);margin-bottom:16px}.footer-links ul{list-style:none;padding:0;margin:0}
.footer-links li a{display:flex;align-items:center;gap:4px;min-height:40px;line-height:24px}.footer-links :global(.web-icon),.footer-links :global(.web-icon svg){width:14px;height:14px}
/* Community destinations carry their logo before the name. */
.footer-links :global(.social-logo),.footer-links :global(.social-logo svg){width:18px;height:18px}.footer-links :global(.social-logo){margin-right:6px;color:var(--muted-foreground);transition:color 180ms ease-out}.footer-links a:hover :global(.social-logo){color:var(--foreground)}
/* The base line: the funding sentence under the logo's column; Privacy, Terms and the way back up under the
   link columns, in one size and colour. Space alone sets it off from the directory. */
.base{align-items:baseline;margin-top:72px;font-size:14px;line-height:22px;color:var(--muted-foreground)}
.base p a{color:var(--foreground);white-space:nowrap}.base p a:hover{text-decoration-thickness:2px}.base p :global(.web-icon),.base p :global(.web-icon svg){width:12px;height:12px}.base p :global(.web-icon){margin-left:2px;vertical-align:-1px}
.base-links{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px 24px}
.legal-links{display:flex;flex-wrap:wrap;gap:4px 24px;list-style:none;padding:0;margin:0}
.legal-links a,.to-top{display:inline-flex;align-items:center;min-height:24px;color:var(--muted-foreground);text-decoration:none}.legal-links a:hover,.to-top:hover{color:var(--foreground)}
/* The design system's arrow, turned to point up. */
.to-top{gap:6px}.to-top :global(.web-icon),.to-top :global(.web-icon svg){width:14px;height:14px}.to-top :global(.web-icon){transform:rotate(-90deg);transition:transform 180ms ease-out}
@media(hover:hover) and (prefers-reduced-motion:no-preference){.to-top:hover :global(.web-icon){transform:rotate(-90deg) translateX(3px)}}
@media(prefers-reduced-motion:reduce){.to-top :global(.web-icon){transition:none}}
/* Below 1280 the footer is two equal halves: the logo and the newsletter side by side over four equal link
   columns with the same gap, so the newsletter's edge lands on the third column; the base line splits on that
   edge too. */
@media(max-width:1279px){.footer-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:48px}.directory{grid-template-columns:minmax(0,1fr);row-gap:56px}.identity{grid-template-columns:repeat(2,minmax(0,1fr));gap:48px;width:100%}.newsletter{max-width:none}.footer-links{gap:48px}}
@media(max-width:1023px){.contact-copy{gap:24px}}
@media(max-width:767px){.footer-main{padding-block:56px 32px}.footer-grid{grid-template-columns:minmax(0,1fr)}.directory{row-gap:48px}.identity{grid-template-columns:minmax(0,1fr);gap:32px}.footer-links{grid-template-columns:repeat(2,minmax(0,1fr));gap:40px 24px}.footer-links li a{min-height:44px}.base{row-gap:12px;margin-top:48px}}
/* Under 375 px the joined button would clip the placeholder: both give up some padding. */
@media(max-width:374px){.newsletter .field input{padding-inline:10px}.newsletter-submit{padding-inline:12px}}
@media(forced-colors:active){.footer-main{border-top:1px solid CanvasText}}
</style>
